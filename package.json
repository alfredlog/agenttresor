{
  "name": "agenttresor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Non-custodial spend control for AI agents on BSV",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "merchant": "tsx src/merchant/server.ts",
    "proxy": "npm run build:web && tsx src/proxy/server.ts",
    "connect": "tsx src/agent/connect-cli.ts",
    "setup": "tsx src/service/cli.ts setup",
    "agents": "tsx src/service/cli.ts agents",
    "mcp": "tsx src/mcp/main.ts",
    "agent:run": "tsx src/service/main.ts",
    "agent:start": "tsx src/service/cli.ts start",
    "agent:stop": "tsx src/service/cli.ts stop",
    "agent:status": "tsx src/service/cli.ts status",
    "agent:install-service": "tsx src/service/cli.ts install-service",
    "agent:uninstall-service": "tsx src/service/cli.ts uninstall-service",
    "agent:tunnel": "tsx src/service/cli.ts tunnel",
    "agent:tunnel-revoke": "tsx src/service/cli.ts tunnel-revoke",
    "audit:verify": "tsx src/audit/verify-cli.ts",
    "build:web": "node scripts/build-web.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "overlay": "tsx src/token/overlay/server.ts"
  },
  "dependencies": {
    "@bsv/402-pay": "0.3.3",
    "@bsv/overlay": "2.6.4",
    "@bsv/overlay-express": "2.7.4",
    "@bsv/sdk": "3.2.1",
    "@bsv/wallet-toolbox": "2.14.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
