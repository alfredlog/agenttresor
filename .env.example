# main | test (default main)
BSV_NETWORK=main
# Server wallet root key: 64 hex characters. Keep it secret; never commit .env.
SERVER_PRIVATE_KEY=
# Demo merchant (npm run merchant)
MERCHANT_ROOT_KEY=
MERCHANT_PORT=5080
# Spend-control proxy (npm run proxy)
PROXY_ROOT_KEY=
PROXY_PORT=5050
# Admin API and dashboard token, at least 16 characters
ADMIN_TOKEN=
