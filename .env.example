# main | test (default main)
BSV_NETWORK=main
# Server wallet root key (src/shared/wallet.ts default): 64 hex characters. Keep it secret; never commit .env.
SERVER_PRIVATE_KEY=
# Demo merchant (npm run merchant): its wallet root key, 64 hex characters
MERCHANT_ROOT_KEY=
MERCHANT_PORT=5080
# Spend-control proxy (npm run proxy). The proxy holds no funds: this key only derives
# the policy key of each vault (one of the two signatures a payment needs) and the
# proxy's identity key (BRC-29 sender). 64 hex characters; keep it secret.
PROXY_ROOT_KEY=
PROXY_PORT=5050
# Admin API, dashboard and vault page token, at least 16 characters
ADMIN_TOKEN=
# The proxy's public URL, for connection links (default: the request's own origin)
PROXY_PUBLIC_URL=
# 1 behind a reverse proxy (nginx, Caddy): client IPs from X-Forwarded-For, for the connect rate limit
TRUST_PROXY=
# Agent side. Normally nothing to set here: `npm run setup <code>` writes a profile per agent
# (mcp-data/agents/<agentId>/) and runs the agent service on 127.0.0.1:MCP_PORT.
# Where the profiles, agent.pid and agent.log live; relative to the project
MCP_DATA_DIR=mcp-data
MCP_PORT=5070
# Only to listen beyond loopback (then MCP_TOKEN, at least 16 characters, is required on every request)
MCP_HOST=
MCP_TOKEN=
# Single-agent stdio server only (npm run --silent mcp): which profile, and overrides of its settings.
# The agent service ignores PROXY_URL, AGENT_API_KEY and MERCHANT_URLS.
AGENT_ID=
PROXY_URL=
AGENT_API_KEY=
# Merchant base URLs for list_services, comma-separated (default: asked from the proxy)
MERCHANT_URLS=

# BSV-21 token overlay (npm run overlay)
# Keep secret; leave empty to use the local key file
OVERLAY_PRIVATE_KEY=
OVERLAY_DB=./data/overlay.db
OVERLAY_PORT=8080
# BSV-21 budget tokens
BSV21_OVERLAY_URL=
BSV21_TOKEN_ID=
BSV21_COMPANY_IDENTITY_KEY=
# Company token issuer wallet private key; keep secret and never commit .env.
BSV21_COMPANY_PRIVATE_KEY=
